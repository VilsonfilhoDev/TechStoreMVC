@model TechStoreMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
}

<h1>Excluir produto</h1>
<p>Tem certeza de que deseja excluir este produto?</p>

<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">Preço</dt>
    <dd class="col-sm-10">@Model.Preco.ToString("F2")</dd>
    <dt class="col-sm-2">Estoque</dt>
    <dd class="col-sm-10">@Model.Estoque</dd>
</dl>

<form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
